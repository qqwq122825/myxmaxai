<Window x:Class="FaceLive.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sdk="clr-namespace:Xmax.SDK.Wpf;assembly=Xmax.SDK.Wpf" xmlns:controls="clr-namespace:FaceLive.Controls"
        Title="FaceLive · 实时换脸工作台" Width="1440" Height="920" MinWidth="1080" MinHeight="680" Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen" PreviewKeyDown="MainWindow_PreviewKeyDown">
<Grid x:Name="RootLayout" Margin="22,16,22,18" Background="{StaticResource Bg}" SizeChanged="Layout_SizeChanged">
    <Grid.RowDefinitions><RowDefinition x:Name="HeaderRow" Height="62"/><RowDefinition Height="*"/><RowDefinition x:Name="FooterRow" Height="86"/></Grid.RowDefinitions>
    <Grid>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
            <Border Width="42" Height="42" CornerRadius="13" Margin="0,0,13,0">
                <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#9099FF"/><GradientStop Color="#5263DF" Offset="1"/></LinearGradientBrush></Border.Background>
                <TextBlock Text="F" FontFamily="Segoe UI" FontSize="27" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White"/>
            </Border>
            <StackPanel><TextBlock Text="FaceLive" FontFamily="Segoe UI" FontSize="23" FontWeight="SemiBold" Margin="0,-3,0,0"/><TextBlock Text="实时换脸工作台" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,2,0,0"/></StackPanel>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,0,0">
            <Border Background="#152B2B" CornerRadius="8" Padding="11,6" Margin="0,0,9,0"><TextBlock Text="● 本地预览免费" Foreground="{StaticResource Ok}" FontSize="11"/></Border>
            <Border Background="#202943" CornerRadius="8" Padding="11,6"><TextBlock Text="Xmax X2.1" Foreground="#B6C0FF" FontSize="11"/></Border>
        </StackPanel>
    </Grid>
    <Grid Grid.Row="1">
        <Grid.ColumnDefinitions><ColumnDefinition Width="292"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}" Padding="18,17">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="0,0,3,0">
                    <TextBlock Text="视频输入" FontSize="15" FontWeight="SemiBold"/>
                    <TextBlock Text="连接摄像头或 YY 开播画面" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,5,0,0"/>
                    <TextBlock Style="{StaticResource Label}" Text="采集后端"/>
                    <ComboBox x:Name="CaptureBackendBox" SelectionChanged="CaptureBackendBox_SelectionChanged"><ComboBoxItem Content="DirectShow · YY / 虚拟摄像头"/><ComboBoxItem Content="Media Foundation · 系统摄像头"/></ComboBox>
                    <TextBlock Style="{StaticResource Label}" Text="采集设备"/>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="54"/></Grid.ColumnDefinitions>
                        <ComboBox x:Name="CameraBox" SelectionChanged="CameraBox_SelectionChanged">
                            <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/></DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button x:Name="RefreshCamerasButton" Grid.Column="1" Content="刷新" Padding="8,7" Margin="6,0,0,0" Click="RefreshCameras_Click"/>
                    </Grid>
                    <CheckBox x:Name="MirrorBox" Click="MirrorBox_Changed" Margin="0,12,0,0">
                        <TextBlock Text="左右镜像 · 预览与生成一致" FontSize="11"/>
                    </CheckBox>
                    <TextBlock Style="{StaticResource Label}" Text="生成画质"/>
                    <ComboBox x:Name="QualityBox" SelectionChanged="QualityBox_SelectionChanged">
                        <ComboBoxItem Content="最高画质 · 固定最高档"/>
                        <ComboBoxItem Content="自适应 · 网络优先"/>
                    </ComboBox>
                    <TextBlock x:Name="QualityHintText" Text="最高档不自动降分辨率；网络不足时可切换自适应。" Foreground="{StaticResource Muted}" FontSize="10" TextWrapping="Wrap" LineHeight="17" Margin="0,6,0,0"/>
                    <Border Background="#1C2740" CornerRadius="8" Padding="10" Margin="0,12,0,0"><TextBlock Text="YY 的横竖屏与分辨率，请在右上方「输出画布」手动选择。" TextWrapping="Wrap" Foreground="#B0BCDB" FontSize="11" LineHeight="18"/></Border>
                    <Border Height="1" Background="{StaticResource Line}" Margin="0,20,0,19"/>
                    <Grid><TextBlock Text="连接账户" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="仅生成时计费" Foreground="{StaticResource Muted}" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
                    <TextBlock Style="{StaticResource Label}" Text="服务区域"/>
                    <ComboBox x:Name="EnvironmentBox" SelectionChanged="EnvironmentBox_SelectionChanged"><ComboBoxItem Content="国际版"/><ComboBoxItem Content="国内版"/></ComboBox>
                    <TextBlock Style="{StaticResource Label}" Text="API KEY"/>
                    <PasswordBox x:Name="ApiKeyBox" PasswordChanged="ApiKeyBox_PasswordChanged"/>
                    <TextBlock Text="支持 uk- / tk- 开头的密钥" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,6,0,0"/>
                    <Border Height="1" Background="{StaticResource Line}" Margin="0,20,0,17"/>
                    <Expander Header="更多画面设置" Foreground="{StaticResource Text}" FontSize="12">
                        <StackPanel Margin="0,6,0,0">
                            <TextBlock Style="{StaticResource Label}" Text="提示词 · 留空使用推荐效果"/>
                            <TextBox x:Name="PromptBox" TextWrapping="Wrap" Height="70" AcceptsReturn="True" LostFocus="Settings_Changed"/>
                            <CheckBox x:Name="FaceRestoreBox" Content="保留原脸（换衣服 / 风格）" Click="Settings_Changed" Margin="0,12,0,6"/>
                            <CheckBox x:Name="FlipBox" Content="上下翻转修正" Click="OutputOptions_Changed"/>
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0"><TextBlock Text="自动停止" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBox x:Name="AutoStopBox" Width="48" Padding="8,6" LostFocus="Settings_Changed"/><TextBlock Text="分钟 · 0 不限制" Foreground="{StaticResource Muted}" FontSize="10" Margin="7,0,0,0" VerticalAlignment="Center"/></StackPanel>
                        </StackPanel>
                    </Expander>
                    <Border Height="1" Background="{StaticResource Line}" Margin="0,18,0,17"/>
                    <TextBlock Text="虚拟摄像头" FontSize="12" FontWeight="SemiBold"/>
                    <TextBlock x:Name="VcamStatusText" Foreground="{StaticResource Muted}" FontSize="10" TextWrapping="Wrap" LineHeight="17" Margin="0,7,0,10"/>
                    <Button x:Name="VcamButton" Click="VcamButton_Click" HorizontalAlignment="Left" FontSize="11"/>
                    <TextBlock Text="直播软件中添加 FaceLive Camera" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,8,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
        <Grid Grid.Column="2">
            <Grid.RowDefinitions><RowDefinition x:Name="OutputToolbarRow" Height="82"/><RowDefinition Height="*"/><RowDefinition Height="16"/><RowDefinition x:Name="ReferenceLibraryRow" Height="190"/></Grid.RowDefinitions>
            <Border Style="{StaticResource Card}" Padding="16,11" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="234"/><ColumnDefinition Width="12"/><ColumnDefinition Width="214"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center"><TextBlock Text="输出画布" FontSize="14" FontWeight="SemiBold"/><TextBlock x:Name="OutputInfoText" Text="手动设置横竖屏与清晰度" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/></StackPanel>
                    <ComboBox x:Name="ResolutionBox" Grid.Column="1" SelectionChanged="ResolutionBox_SelectionChanged" VerticalAlignment="Center" ToolTip="手动选择输出分辨率；YY 输入也会请求相同尺寸"/>
                    <ComboBox x:Name="FrameFitBox" Grid.Column="3" SelectionChanged="FrameFitBox_SelectionChanged" VerticalAlignment="Center" ToolTip="填满画布会裁剪边缘；完整画面会保留黑边"><ComboBoxItem Content="填满画布 · 裁剪边缘"/><ComboBoxItem Content="完整画面 · 保留边缘"/></ComboBox>
                </Grid>
            </Border>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}">
                    <Grid Margin="12">
                        <Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="*"/><RowDefinition Height="26"/></Grid.RowDefinitions>
                        <Grid><TextBlock Text="原始画面" FontWeight="SemiBold" FontSize="13"/><TextBlock x:Name="InputStateText" Text="● 等待输入" Foreground="{StaticResource Muted}" FontSize="10" HorizontalAlignment="Right" Margin="0,2,0,0"/></Grid>
                        <Border Grid.Row="1" Background="#090E18" CornerRadius="10" ClipToBounds="True">
                            <Grid><controls:AspectRatioBox x:Name="LocalAspect"><sdk:XmaxRealtimeVideoView x:Name="LocalView" ContentMode="Fill"/></controls:AspectRatioBox><TextBlock x:Name="LocalPlaceholder" Text="等待输入画面" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
                        </Border>
                        <TextBlock x:Name="InputInfoText" Grid.Row="2" Text="选择设备后自动预览" Foreground="{StaticResource Muted}" FontSize="10" VerticalAlignment="Bottom" TextTrimming="CharacterEllipsis"/>
                    </Grid>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}" BorderBrush="#3A456A">
                    <Grid Margin="12">
                        <Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="*"/><RowDefinition Height="26"/></Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="生成画面" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                            <Border x:Name="LiveBadge" Grid.Column="1" Visibility="Collapsed" Background="#283153" CornerRadius="5" Padding="7,2" VerticalAlignment="Center" Margin="0,0,8,0"><TextBlock x:Name="LiveBadgeText" Text="● 生成中" Foreground="#BBC3FF" FontSize="10"/></Border>
                            <Button Grid.Column="2" Content="大屏预览 ↗" Click="OpenGeneratedPreview_Click" Padding="9,4" FontSize="10" VerticalAlignment="Center" ToolTip="F10 打开独立窗口，可缩放、置顶或全屏"/>
                        </Grid>
                        <Border Grid.Row="1" Background="#090E18" CornerRadius="10" ClipToBounds="True" MouseLeftButtonDown="GeneratedPreview_MouseLeftButtonDown" ToolTip="双击打开独立大屏预览">
                            <Grid>
                                <controls:AspectRatioBox x:Name="RemoteAspect"><sdk:XmaxRealtimeVideoView x:Name="RemoteView" ContentMode="Fill"/></controls:AspectRatioBox>
                                    <StackPanel x:Name="RemotePlaceholder" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Border Width="52" Height="52" Background="#202A48" CornerRadius="17" HorizontalAlignment="Center" Margin="0,0,0,15"><TextBlock Text="✦" FontSize="29" Foreground="#9CA7FF" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                        <TextBlock Text="让画面换个新模样" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Center"/>
                                        <TextBlock Text="选择参考图，然后开始生成" Foreground="{StaticResource Muted}" FontSize="10" HorizontalAlignment="Center" Margin="0,7,0,0"/>
                                    </StackPanel>
                            </Grid>
                        </Border>
                        <TextBlock x:Name="GeneratedInfoText" Grid.Row="2" Text="等待生成 · 实际尺寸将在这里显示" Foreground="{StaticResource Muted}" FontSize="10" VerticalAlignment="Bottom" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                    </Grid>
                </Border>
            </Grid>
            <Border Grid.Row="3" Style="{StaticResource Card}" Padding="14,12">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="*"/><RowDefinition x:Name="ReferenceFootnoteRow" Height="17"/></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="效果与参考图" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <StackPanel x:Name="ModePanel" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"/>
                        <Button x:Name="UploadButton" Grid.Column="2" Content="＋ 上传图片" Click="UploadImage_Click" Padding="11,7" FontSize="11"/>
                    </Grid>
                    <ListBox x:Name="ReferenceList" Grid.Row="1" Tag="58" Background="Transparent" BorderThickness="0" Margin="0,9,0,0" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled" SelectionChanged="ReferenceList_SelectionChanged">
                        <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel>
                        <ListBox.ItemTemplate><DataTemplate>
                            <StackPanel Width="86"><Border Background="#22304A" CornerRadius="7" Height="{Binding Tag, RelativeSource={RelativeSource AncestorType=ListBox}}" ClipToBounds="True"><Image Source="{Binding Thumbnail, TargetNullValue={x:Null}}" Stretch="UniformToFill"/></Border><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontSize="10" Height="14" HorizontalAlignment="Center" Margin="0,4,0,0"/></StackPanel>
                        </DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Grid.Row="2" Text="直播中可点击参考图切换效果 · 仅使用本人、自有或已获授权的形象" Foreground="{StaticResource Muted}" FontSize="9" VerticalAlignment="Bottom"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
    <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,14,0,0" Padding="17,11">
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="185"/><ColumnDefinition Width="230"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                <TextBlock x:Name="StatusText" Text="准备就绪" FontSize="11" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="MetricsText" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,4,0,0"/>
                <TextBlock x:Name="ErrorText" Foreground="#FFA9AD" FontSize="10" TextTrimming="CharacterEllipsis" MaxHeight="16" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0" HorizontalAlignment="Right">
                <TextBlock x:Name="ElapsedText" Text="00:00:00" FontFamily="Consolas" FontSize="22" HorizontalAlignment="Right"/>
                <TextBlock x:Name="CreditText" Text="生成时约 1 积分 / 秒" Foreground="{StaticResource Muted}" FontSize="9" Margin="0,3,0,0" HorizontalAlignment="Right"/>
            </StackPanel>
            <Button x:Name="StartButton" Grid.Column="2" Content="开始生成并输出" Click="StartButton_Click" Background="{StaticResource Accent}" BorderBrush="{StaticResource Accent}" Foreground="White" FontSize="14" FontWeight="SemiBold"/>
        </Grid>
    </Border>
</Grid>
</Window>
