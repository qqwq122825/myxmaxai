<Window x:Class="FaceLive.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:sdk="clr-namespace:Xmax.SDK.Wpf;assembly=Xmax.SDK.Wpf"
        Title="换脸直播助手" Width="1320" Height="820" MinWidth="1000" MinHeight="640"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#272A31"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="CaretBrush" Value="{StaticResource Text}"/>
            <Setter Property="Padding" Value="6,5"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="#272A31"/>
            <Setter Property="Foreground" Value="{StaticResource Text}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
            <Setter Property="CaretBrush" Value="{StaticResource Text}"/>
            <Setter Property="Padding" Value="6,5"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="6,5"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="360"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left: controls -->
        <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,16,20,8">
                    <StackPanel>
                        <TextBlock Text="换脸直播助手" FontSize="20" FontWeight="SemiBold"/>
                        <TextBlock Text="在直播伴侣里添加摄像头「FaceLive Camera」即可" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0"/>

                        <TextBlock Style="{StaticResource Label}" Text="API KEY（uk- 或 tk- 开头）"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <PasswordBox x:Name="ApiKeyBox" PasswordChanged="ApiKeyBox_PasswordChanged"/>
                            <ComboBox x:Name="EnvironmentBox" Grid.Column="1" Width="84" Margin="8,0,0,0" SelectionChanged="EnvironmentBox_SelectionChanged">
                                <ComboBoxItem Content="国际版"/>
                                <ComboBoxItem Content="国内版"/>
                            </ComboBox>
                        </Grid>

                        <TextBlock Style="{StaticResource Label}" Text="真实摄像头"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="CameraBox" DisplayMemberPath="Name" SelectionChanged="CameraBox_SelectionChanged"/>
                            <Button Grid.Column="1" Content="刷新" Margin="8,0,0,0" Click="RefreshCameras_Click"/>
                        </Grid>

                        <TextBlock Style="{StaticResource Label}" Text="输出分辨率（直播伴侣收到的画面大小）"/>
                        <ComboBox x:Name="ResolutionBox" SelectionChanged="ResolutionBox_SelectionChanged"/>

                        <TextBlock Style="{StaticResource Label}" Text="效果"/>
                        <StackPanel x:Name="ModePanel" Orientation="Horizontal"/>

                        <Grid Margin="0,14,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="参考图（直播中点击可直接切换）" Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center"/>
                            <Button x:Name="UploadButton" Grid.Column="1" Content="＋ 上传图片" Padding="10,4" Click="UploadImage_Click"/>
                        </Grid>
                        <ListBox x:Name="ReferenceList" Height="300" Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="ReferenceList_SelectionChanged">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Width="88" Margin="2">
                                        <Border CornerRadius="6" Width="80" Height="80" Background="#2A2D35" ClipToBounds="True">
                                            <Image Source="{Binding Thumbnail, TargetNullValue={x:Null}}" Stretch="UniformToFill"/>
                                        </Border>
                                        <TextBlock Text="{Binding Name}" FontSize="11" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Text="仅使用本人、自有或已获授权的形象。" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0"/>

                        <Expander Header="高级设置" Foreground="{StaticResource Text}" Margin="0,14,0,0">
                            <StackPanel Margin="0,6,0,0">
                                <TextBlock Style="{StaticResource Label}" Margin="0,4,0,6" Text="提示词（留空用官方推荐）"/>
                                <TextBox x:Name="PromptBox" TextWrapping="Wrap" Height="54" AcceptsReturn="False" LostFocus="Settings_Changed"/>
                                <CheckBox x:Name="FaceRestoreBox" Content="保留原脸（换衣服/风格时用）" Click="Settings_Changed" Margin="0,10,0,4"/>
                                <CheckBox x:Name="MirrorBox" Content="虚拟摄像头左右镜像" Click="OutputOptions_Changed"/>
                                <CheckBox x:Name="FlipBox" Content="上下翻转修正（画面倒置时切换）" Click="OutputOptions_Changed"/>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <TextBlock Text="自动停止：" VerticalAlignment="Center"/>
                                    <TextBox x:Name="AutoStopBox" Width="50" LostFocus="Settings_Changed"/>
                                    <TextBlock Text=" 分钟（0 = 不限制）" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
                                </StackPanel>
                            </StackPanel>
                        </Expander>

                        <TextBlock Style="{StaticResource Label}" Text="虚拟摄像头"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="VcamStatusText" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            <Button x:Name="VcamButton" Grid.Column="1" Click="VcamButton_Click" Margin="8,0,0,0"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <Border Grid.Row="1" Padding="20,12,20,18" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
                    <Button x:Name="StartButton" Height="48" FontSize="16" FontWeight="SemiBold" Background="{StaticResource Accent}"
                            BorderBrush="{StaticResource Accent}" Foreground="White" Content="启动虚拟摄像头" Click="StartButton_Click"/>
                </Border>
            </Grid>
        </Border>

        <!-- Right: video -->
        <Grid Grid.Column="1" Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Background="Black" CornerRadius="10" ClipToBounds="True">
                <Grid>
                    <sdk:XmaxRealtimeVideoView x:Name="RemoteView" ContentMode="Fit"/>
                    <TextBlock x:Name="RemotePlaceholder" Text="换脸后的画面会显示在这里" Foreground="{StaticResource Muted}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="15"/>
                    <Border Width="280" Height="158" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="14"
                            Background="#111" BorderBrush="#55FFFFFF" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                        <Grid>
                            <sdk:XmaxRealtimeVideoView x:Name="LocalView" ContentMode="Fit"/>
                            <TextBlock Text="原始画面" Foreground="White" FontSize="11" Margin="8,5" Opacity="0.8"/>
                        </Grid>
                    </Border>
                    <Border x:Name="LiveBadge" Background="{StaticResource Accent}" CornerRadius="4" Padding="8,3"
                            HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14" Visibility="Collapsed">
                        <TextBlock x:Name="LiveBadgeText" Text="● 生成中" Foreground="White" FontWeight="SemiBold" FontSize="12"/>
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="2,12,2,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="StatusText" Text="准备就绪"/>
                    <TextBlock x:Name="MetricsText" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0"/>
                    <TextBlock x:Name="ErrorText" Foreground="{StaticResource Accent}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                    <TextBlock x:Name="ElapsedText" Text="00:00:00" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                    <TextBlock x:Name="CreditText" Text="本次约消耗 0 积分" Foreground="{StaticResource Muted}" FontSize="12" HorizontalAlignment="Right"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
